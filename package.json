{
  "name": "medusa-all",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "pnpm --parallel -r dev",
    "dev:backend": "pnpm --filter @medusa-all/backend dev",
    "dev:storefront": "pnpm --filter medusa-next dev",
    "lint": "turbo lint",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "pnpm": {
    "packageExtensions": {
      "tailwindcss-radix@*": {
        "dependencies": {
          "tailwindcss": "^3.4.1"
        }
      }
    }
  },
  "packageManager": "pnpm@10.33.0"
}